#!/usr/bin/env bash
#MISE description="Run BATS and Python tests"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" var=#true default="" help="A Python test target, or BATS files, directories, and arguments"
#USAGE example "mise run test" header="Run all BATS and Python tests"
#USAGE example "mise run test test/list.bats" header="Run one BATS test file"
#USAGE example "mise run test test/python/test_audit.py" header="Run one Python test file"
#USAGE example "mise run test --filter rejects" header="Filter BATS tests by name"
#USAGE example "mise run test --jobs 1" header="Run BATS serially for debugging"
set -euo pipefail

export BATS_DEFAULT_TEST_TARGET="$MISE_CONFIG_ROOT/test"
export BATS_NUMBER_OF_PARALLEL_JOBS="${BATS_NUMBER_OF_PARALLEL_JOBS:-8}"
export BATS_PARALLEL_BINARY_NAME="${BATS_PARALLEL_BINARY_NAME:-rush}"
export BATS_NO_PARALLELIZE_WITHIN_FILE="${BATS_NO_PARALLELIZE_WITHIN_FILE:-true}"

uv_command="${UV_COMMAND:-uv}"

run_bats() {
  if [ -n "${BATS_COMMAND:-}" ]; then
    "$BATS_COMMAND" --print-output-on-failure "$@"
  else
    bats --print-output-on-failure "$@"
  fi
}

if [ "$#" -eq 0 ]; then
  run_bats
  exec "$uv_command" run --with pytest pytest "$MISE_CONFIG_ROOT/test/python"
fi

case "$1" in
  *.py|test/python/*|"$MISE_CONFIG_ROOT/test/python/"*)
    exec "$uv_command" run --with pytest pytest "$@"
    ;;
esac

run_bats "$@"
